# Copy to .env for local dev (`vercel dev`), or set these as Environment
# Variables in your Vercel project settings for production. Never commit
# the real values — .env is gitignored.
#
# Without these set, /api/discussions returns demo data so the "what other
# readers think" UI still works for testing.

# From https://www.reddit.com/prefs/apps — create a "script" type app.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying your app.
REDDIT_USER_AGENT=epubfeed/1.0 (by u/your-username)

# From https://docs.hardcover.app/api/getting-started
HARDCOVER_API_TOKEN=

# From https://openrouter.ai/keys — used to split non-chaptered content
# (PDFs, video transcripts) into topic sections. Check
# https://openrouter.ai/models?max_price=0 for current free models; defaults
# to meta-llama/llama-3.1-8b-instruct:free if OPENROUTER_MODEL is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=

# Firebase — powers "Sign in" and cross-device library sync. From the
# Firebase console (console.firebase.google.com): create a project, add a
# Web app, and copy these values from Project settings > General > Your
# apps > SDK setup and configuration. Then enable Authentication > Sign-in
# method > Google, and create a Firestore database (production mode).
#
# These are VITE_-prefixed because they're read by the frontend build and
# end up in the shipped JS bundle — that's expected for Firebase web config,
# which isn't a secret (access is controlled by Firestore security rules,
# not by hiding this object). Without these set, sign-in is simply hidden/
# disabled rather than broken.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
